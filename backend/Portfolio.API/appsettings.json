{
  "AllowedOrigins": "http://localhost:3000",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_SUPABASE_CONNECTION_STRING"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "PortfolioAPI",
    "Audience": "PortfolioClient",
    "ExpiryHours": 24
  },
  "EmailSettings": {
    "ResendApiKey": "YOUR_RESEND_API_KEY",
    "RecipientEmail": "YOUR_RECIPIENT_EMAIL"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
